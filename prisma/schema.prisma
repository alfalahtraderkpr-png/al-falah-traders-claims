generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String      @id @default(cuid())
  name          String
  email         String      @unique
  password      String
  role          String      @default("admin") // "admin" or "orderbooker"
  orderBookerId String?     @unique // if role is orderbooker, link to OrderBooker
  orderBooker   OrderBooker? @relation(fields: [orderBookerId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Company {
  id              String   @id @default(cuid())
  name            String
  multiTierPricing Boolean @default(false) // Cadbury = true, others = false
  claimDeductionPercent Float @default(0) // e.g., 22 for Shan Masala = 22% deduction on claims
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  products        Product[]
  suppliers       Supplier[]
  claims          Claim[]
  shopOrderBookers ShopCompanyOrderBooker[]
  creditLimits     ShopCreditLimit[]
}

model Product {
  id             String   @id @default(cuid())
  name           String   // e.g. "Zeera", "Coconut"
  price          Float    // e.g. 10, 20, 50 (Retail/Trade price)
  claimPrice     Float    @default(0) // Claim rate per unit - user sets manually (e.g. 20 for N.K Rs.20)
  wholesalePrice Float?   // Wholesale price (only for multi-tier companies like Cadbury)
  lmtPrice       Float?   // LMT price (only for multi-tier companies like Cadbury)
  unit           String   @default("pcs") // pcs, Box, Ctn
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  claimItems     ClaimItem[]
  priceHistory   ProductPriceHistory[]

  @@unique([name, price, companyId])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  claims    Claim[]
}

model Shop {
  id                  String   @id @default(cuid())
  name                String
  address             String   @default("")
  shopType            String   @default("retail") // retail, wholesale, lmt
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  claims              Claim[]
  companyOrderBookers ShopCompanyOrderBooker[]
  creditLimits        ShopCreditLimit[]
}

model OrderBooker {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  claims    Claim[]
  shopCompanyOrderBookers ShopCompanyOrderBooker[]
  user      User?    // reverse relation - one order booker can have one login
}

model Claim {
  id            String     @id @default(cuid())
  claimNumber   String     @unique // e.g. CLM-001
  date          DateTime
  companyId     String
  company       Company    @relation(fields: [companyId], references: [id])
  shopId        String
  shop          Shop       @relation(fields: [shopId], references: [id])
  supplierId    String
  supplier      Supplier   @relation(fields: [supplierId], references: [id])
  orderBookerId String?
  orderBooker   OrderBooker? @relation(fields: [orderBookerId], references: [id])
  totalAmount     Float      @default(0) // gross amount before deduction
  deductionAmount Float      @default(0) // deduction amount (e.g., 22% of total)
  netAmount       Float      @default(0) // totalAmount - deductionAmount
  approvedAmount  Float?    // null means not yet approved, can be partial
  status        String     @default("pending") // pending, approved, partially_approved, cleared, rejected
  clearedBy     String?    // name of person who cleared
  clearedDate   DateTime?  // when it was cleared
  rejectReason  String?
  createdBy     String?    // user id or name who created/entered the claim
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  claimItems    ClaimItem[]
  attachments   ClaimAttachment[]
}

model ShopCompanyOrderBooker {
  id            String   @id @default(cuid())
  shopId        String
  companyId     String
  orderBookerId String?
  shopType      String   @default("retail") // retail, wholesale, lmt — per company override
  shop          Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderBooker   OrderBooker? @relation(fields: [orderBookerId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shopId, companyId])
}

model ClaimItem {
  id        String  @id @default(cuid())
  claimId   String
  claim     Claim   @relation(fields: [claimId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  amount    Float   // price * quantity (auto-calculated)
}

model ProductPriceHistory {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldPrice  Float
  newPrice  Float
  oldClaimPrice  Float @default(0)
  newClaimPrice  Float @default(0)
  oldWholesalePrice Float?
  newWholesalePrice Float?
  oldLmtPrice Float?
  newLmtPrice Float?
  changedBy String?  // user who changed
  changedAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String   // create, update, delete, approve, reject, clear, status_change
  entity    String   // claim, product, shop, company, etc
  entityId  String?
  details   String?  // JSON string with change details
  createdAt DateTime @default(now())
}

model ClaimAttachment {
  id        String   @id @default(cuid())
  claimId   String
  claim     Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  url       String   // base64 or URL
  type      String   @default("image") // image, document
  createdAt DateTime @default(now())
}

model ShopCreditLimit {
  id            String   @id @default(cuid())
  shopId        String
  companyId     String
  creditLimit   Float    @default(0) // max claim amount allowed
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shopId, companyId])
}
